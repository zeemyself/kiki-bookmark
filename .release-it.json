{
  "git": {
    "commitMessage": "chore(release): v${version}",
    "tagName": "v${version}",
    "requireCleanWorkingDir": true,
    "requireBranch": "master"
  },
  "github": {
    "release": true
  },
  "npm": {
    "publish": false
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": {
        "name": "conventionalcommits"
      },
      "infile": "CHANGELOG.md"
    },
    "@release-it/bumper": {
      "out": {
        "file": "app.json",
        "path": "expo.version"
      }
    }
  },
  "hooks": {
    "before:init": ["npm run typecheck", "npm test"]
  }
}
